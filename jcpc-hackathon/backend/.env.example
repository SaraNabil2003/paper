# Server Configuration
PORT=5000
NODE_ENV=development

# OpenAI API (optional - uses fallback if not set)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
USE_POSTGRES=false  # Set to 'true' to use PostgreSQL instead of in-memory database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=psf_database
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication
JWT_SECRET=your_very_secure_random_secret_key_here_min_32_characters
JWT_EXPIRATION=7d  # Token expiration (e.g., 7d, 24h, 60m)
BCRYPT_ROUNDS=10

# CORS
FRONTEND_URL=http://localhost:5173

# Code Execution Service
CODE_EXECUTION_TIMEOUT=5000  # milliseconds
MAX_CODE_LENGTH=10000  # characters
